{
  "name": "ember-fit",
  "private": true,
  "version": "0.3.0-beta.1",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "description": "EMBER — Keep the fire. PWA luyện tập cá nhân: gym, chạy bộ, tiến trình. Local-first, offline.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "test:smoke": "python scripts/with_server.py --server \"npm run dev -- --port 5173 --strictPort\" --port 5173 -- python scripts/smoke_test.py",
    "test:release": "python scripts/with_server.py --server \"python scripts/serve_build.py\" --port 4173 -- python scripts/release_test.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@fontsource/be-vietnam-pro": "^5.1.0",
    "@types/leaflet": "^1.9.22",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.6.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
